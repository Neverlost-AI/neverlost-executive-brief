# Public Supabase project settings. The publishable key is designed for
# browser use and remains constrained by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Playwright acceptance test account. Use a dedicated non-production user.
E2E_TEST_EMAIL=test-user@example.com
E2E_TEST_PASSWORD=replace-with-test-password
