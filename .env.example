# Public Supabase project settings. The anon key is designed for browser use
# and remains constrained by Row Level Security.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Playwright acceptance test account. Use a dedicated non-production user.
E2E_TEST_EMAIL=test-user@example.com
E2E_TEST_PASSWORD=replace-with-test-password
